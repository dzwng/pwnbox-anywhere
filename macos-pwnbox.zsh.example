# Copy to ~/.config/pwnbox/aliases.zsh, then source it from ~/.zshrc.
# Hostnames/interactive keys live in ~/.ssh/config (config/ssh-macos.conf.example).
# Clear VMware-only helpers left in a shell that previously sourced v1.
unset PWNBOX_PC_MAC PWNBOX_VMRUN PWNBOX_VMX
if [ -n "${ZSH_VERSION:-}" ]; then
  unfunction _pwnbox_windows_ps _pwnbox_wait_for_ssh 2>/dev/null || true
fi
PWNBOX_RELAY_HOST=${PWNBOX_RELAY_HOST:-pwnbox-relay}
PWNBOX_KALI_HOST=${PWNBOX_KALI_HOST:-kali}
PWNBOX_SOCKS_SOCKET=${PWNBOX_SOCKS_SOCKET:-$HOME/.ssh/pwnbox-socks.sock}
PWNBOX_VNC_SOCKET=${PWNBOX_VNC_SOCKET:-$HOME/.ssh/pwnbox-vnc.sock}
pwnbox() {
  case "${1:-help}" in
    status|wake|windows|kali|off|doctor)
      [ "$#" -eq 1 ] || { printf 'Usage: pwnbox <command>\n' >&2; return 2; }
      ssh -T -o BatchMode=yes -o ConnectTimeout=5 "$PWNBOX_RELAY_HOST" "/usr/local/bin/pwnbox $1"
      ;;
    ssh) shift; ssh "$PWNBOX_KALI_HOST" "$@";;
    help|-h|--help) printf 'pwnbox status|wake|windows|kali|off|doctor|ssh\n';;
    *) printf 'Unknown command: %s\n' "$1" >&2; return 2;;
  esac
}
# Compatibility aliases now select or shut down the bare-metal OS.
pc_up() { pwnbox windows; }
kali_up() { pwnbox kali; }
pwnbox_up() { pwnbox kali; }
pc_down() { pwnbox off; }
kali_down() { pwnbox off; }
pwnbox_down() { pwnbox off; }
pwnbox_ssh() { pwnbox ssh "$@"; }
pwnbox_vnc() {
  ssh "$PWNBOX_KALI_HOST" 'pwnbox-kali vnc start' || return
  if ! ssh -S "$PWNBOX_VNC_SOCKET" -O check "$PWNBOX_KALI_HOST" >/dev/null 2>&1; then
    ssh -M -S "$PWNBOX_VNC_SOCKET" -o ControlPersist=no -o ExitOnForwardFailure=yes \
      -fN -L 127.0.0.1:5901:127.0.0.1:5901 "$PWNBOX_KALI_HOST" || return
  fi
  printf 'VNC viewer: 127.0.0.1:5901. SSH tunnel is running in the background.\n'
  printf 'Disconnect tunnel: pwnbox_vnc_disconnect; end desktop: pwnbox_vnc_stop.\n'
}
pwnbox_vnc_disconnect() {
  if ssh -S "$PWNBOX_VNC_SOCKET" -O check "$PWNBOX_KALI_HOST" >/dev/null 2>&1; then
    ssh -S "$PWNBOX_VNC_SOCKET" -O exit "$PWNBOX_KALI_HOST" || return
  fi
  printf 'VNC tunnel closed; Kali desktop session is kept.\n'
}
pwnbox_vnc_stop() {
  ssh "$PWNBOX_KALI_HOST" 'pwnbox-kali vnc stop' || return
  pwnbox_vnc_disconnect
}
proxy_up() {
  if ssh -S "$PWNBOX_SOCKS_SOCKET" -O check "$PWNBOX_KALI_HOST" >/dev/null 2>&1; then
    printf 'SOCKS already running on 127.0.0.1:1080.\n'; return 0
  fi
  ssh -M -S "$PWNBOX_SOCKS_SOCKET" -o ControlPersist=no -o ExitOnForwardFailure=yes \
    -fN -D 127.0.0.1:1080 "$PWNBOX_KALI_HOST"
}
proxy_down() { ssh -S "$PWNBOX_SOCKS_SOCKET" -O exit "$PWNBOX_KALI_HOST"; }
kali_pull() {
  [ -n "${1:-}" ] || { printf 'Usage: kali_pull <kali-path> [mac-dest]\n' >&2; return 2; }
  scp -r -- "$PWNBOX_KALI_HOST:$1" "${2:-.}"
}
kali_push() {
  [ -n "${1:-}" ] || { printf 'Usage: kali_push <mac-path> [kali-dest]\n' >&2; return 2; }
  scp -r -- "$1" "$PWNBOX_KALI_HOST:${2:-}"
}
